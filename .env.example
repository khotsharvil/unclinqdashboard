# Unclinq therapist dashboard — environment.
# Copy to `.env` for local dev (values below are the local defaults).

# Backend API base. Leave unset locally to use the Vite dev proxy (-> :3001).
# In production this MUST be the absolute backend URL, e.g.
#   VITE_API_URL=https://unclinq-backend-production.up.railway.app/api
VITE_API_URL=

# Where the CLIENT app is hosted — used to build invitation links the client
# opens (`${VITE_CLIENT_APP_URL}/#/onboarding?code=XXXX`). Defaults to the local
# client dev server.
VITE_CLIENT_APP_URL=http://localhost:5173

# Set to 1 to run the dashboard fully on local mock data (no backend, no login).
VITE_DEMO=
