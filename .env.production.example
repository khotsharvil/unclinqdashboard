# PRODUCTION build-time env for the therapist dashboard.
# Set these as Railway variables on the dashboard service (they override any
# committed file). Vite inlines VITE_* vars at build time, so the service must
# be redeployed after changing them.

# Absolute backend API base (with /api on the end).
VITE_API_URL=https://unclinq-backend-production.up.railway.app/api

# The deployed CLIENT app origin — invitation links point here.
VITE_CLIENT_APP_URL=https://unclinq-frontend-production-6212.up.railway.app
