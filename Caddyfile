# Disable Caddy's admin API (port 2019) so Railway never mis-detects it as the
# web port when a custom domain is added — the only listening port is $PORT.
{
	admin off
}

:{$PORT} {
	encode gzip
	root * dist

	# Security headers (see client Caddyfile). Level-1 CSP + clickjacking guard.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Hashed build assets are immutable and must resolve to a real file — never the
	# SPA shell. A stale chunk request after a deploy returns a clean 404 (not
	# index.html), which the client can recover from with a reload.
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Single-page app: every other path falls back to index.html.
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}
